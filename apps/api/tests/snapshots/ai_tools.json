[
  {
    "function": {
      "description": "Find tasks the user can see with structured filters (text, project, assignee, status, due range, overdue). Returns keys like T-123 to use with other tools.",
      "name": "search_tasks",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "assignee": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "\"me\", a name, an email, or \"none\" for unassigned tasks"
          },
          "due_after": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Due on or after this date"
          },
          "due_before": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Due on or before this date"
          },
          "limit": {
            "default": 20,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "overdue": {
            "default": false,
            "description": "Only open tasks due before today",
            "type": "boolean"
          },
          "project": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Project name or id"
          },
          "status": {
            "default": "open",
            "description": "Open tasks by default",
            "enum": [
              "open",
              "completed",
              "any"
            ],
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Words to look for in titles and descriptions"
          }
        },
        "type": "object"
      }
    },
    "type": "function"
  },
  {
    "function": {
      "description": "Search tasks, comments, attached files and project briefs by meaning (not just exact words). Returns snippets with citations like [T-123] to quote in answers.",
      "name": "semantic_search",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 8,
            "maximum": 15,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "description": "What to look for, in the user's own words",
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "types": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "task",
                    "comment",
                    "attachment",
                    "project"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Limit to some kinds of content; default: all"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
  {
    "function": {
      "description": "Details of one task: fields, description, subtasks, blockers and recent comments.",
      "name": "get_task",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "task": {
            "additionalProperties": false,
            "description": "Exactly one of ``id``, ``key`` or ``title_query``. A bare string is accepted too:\n``\"T-12\"`` is read as a key, a UUID as an id, anything else as a title query.",
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "format": "uuid",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Task id, when known exactly"
              },
              "key": {
                "anyOf": [
                  {
                    "pattern": "^[Tt]-\\d{1,9}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Task key such as \"T-123\""
              },
              "project": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Project name or id to narrow a title_query"
              },
              "title_query": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Words from the task title, when neither the id nor the key is known"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "task"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
