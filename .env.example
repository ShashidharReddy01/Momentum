# Momentum: local development defaults. Every setting is documented in docs/architecture/configuration.md
MOMENTUM_ENV=local
MOMENTUM_SECRET_KEY=dev-only-change-me
MOMENTUM_BASE_PATH=
MOMENTUM_PUBLIC_BASE_URL=http://localhost:5173
MOMENTUM_LOG_LEVEL=INFO
MOMENTUM_LOG_FORMAT=console

# Database (docker compose postgres + pgvector)
MOMENTUM_DATABASE_URL=postgresql+psycopg://momentum:momentum@localhost:5432/momentum
MOMENTUM_DB_SCHEMA=momentum
MOMENTUM_DB_AUTO_MIGRATE=true

# Auth: dev | easyauth-sim | easyauth | oidc | host
MOMENTUM_AUTH_MODE=dev
MOMENTUM_BOOTSTRAP_ADMIN_EMAILS=admin@acme-demo.test
MOMENTUM_ALLOWED_EMAIL_DOMAINS=acme-demo.test
MOMENTUM_IDENTITY_LINK_BY_EMAIL=true

# Worker
MOMENTUM_WORKER_MODE=embedded
# Web processes for `momentum serve` (~150 active people: 4, with a smaller pool per process)
MOMENTUM_WEB_WORKERS=1
# Rules executor kill switch (rules stay editable; nothing fires when false)
MOMENTUM_RULES_ENABLED=true
# Public form spam limits (S4.2.1): salt for hashing a submitter's IP (never store it raw),
# and how many submissions a form accepts per IP / in total inside the rolling window.
MOMENTUM_FORMS_IP_HASH_SALT=dev-only-change-me
MOMENTUM_FORMS_RATE_LIMIT_PER_IP=5
MOMENTUM_FORMS_RATE_LIMIT_PER_FORM=60
MOMENTUM_FORMS_RATE_LIMIT_WINDOW_MINUTES=10
# Reverse proxies in front that append to X-Forwarded-For (Azure App Service: 1; none: 0)
MOMENTUM_TRUSTED_PROXY_HOPS=0

# Storage
MOMENTUM_STORAGE_BACKEND=local
MOMENTUM_STORAGE_LOCAL_DIR=./.data/files

# AI: mock by default; set gateway + URL/key to use any OpenAI-compatible gateway
# (LiteLLM, Portkey, ...). Then run `uv run momentum llm-check`.
MOMENTUM_AI_ENABLED=true
MOMENTUM_LLM_MODE=mock
MOMENTUM_LLM_BASE_URL=http://localhost:4000/v1
MOMENTUM_LLM_API_KEY=
# Portkey-style gateways: MOMENTUM_LLM_API_KEY_HEADER=x-portkey-api-key
MOMENTUM_LLM_API_KEY_HEADER=Authorization
MOMENTUM_LLM_EXTRA_HEADERS={}
MOMENTUM_LLM_MODEL_FAST=claude-fast
MOMENTUM_LLM_MODEL_DEFAULT=claude-default
MOMENTUM_LLM_MODEL_SMART=claude-smart
MOMENTUM_LLM_EMBED_MODEL=cohere-embed-v3
MOMENTUM_LLM_EMBED_DIM=1024
MOMENTUM_LLM_EMBED_BATCH=96
MOMENTUM_LLM_TIMEOUT_S=60
MOMENTUM_LLM_MAX_RETRIES=2
MOMENTUM_LLM_SUPPORTS_STREAMING_TOOLS=true
MOMENTUM_LLM_RERANK_MODEL=cohere-rerank-v3.5
MOMENTUM_AI_RERANK=false
MOMENTUM_LLM_PRICE_TABLE={}
MOMENTUM_LLM_FIXTURES_DIR=
# Throwaway database for `make evals` (reset on every run; name must end in _evals). Empty = <main db>_evals
MOMENTUM_EVALS_DATABASE_URL=
MOMENTUM_AI_MONTHLY_BUDGET_USD=0
# One person's own model calls per rolling hour (agents excluded); 0 = unlimited
MOMENTUM_AI_USER_CALLS_PER_HOUR=200

# Agents (Phase 5): kill switch, and ceilings for every agent's per-run limits
MOMENTUM_AGENTS_ENABLED=true
# a host's agent extensions (tools, handler agents, definitions): "package.module:attribute"
MOMENTUM_AGENT_EXTENSIONS=
MOMENTUM_AGENT_MAX_STEPS=15
MOMENTUM_AGENT_TIMEOUT_S=300

# Planning (Phase 6): weekly hours people plan against unless they or an admin set their own
MOMENTUM_WORKLOAD_DEFAULT_HOURS=30
# Forecasts (S6.5.3): Monte Carlo runs per project forecast; the nightly job kill switch
MOMENTUM_FORECAST_RUNS=10000
MOMENTUM_FORECASTS_ENABLED=true

# Phase 7.5: files, vision, reports, snapshots (ADR-0011)
MOMENTUM_LLM_SUPPORTS_VISION=true
MOMENTUM_AI_MAX_IMAGES_PER_CALL=5
MOMENTUM_AI_MAX_IMAGES_PER_CONVERSATION=20
MOMENTUM_FILE_PARSE_TIMEOUT_S=20
MOMENTUM_FILE_PARSE_MAX_ROWS=200000
MOMENTUM_REPORT_TIMEOUT_S=120
MOMENTUM_AI_TASK_SUGGESTIONS=true
MOMENTUM_SNAPSHOTS_ENABLED=true
MOMENTUM_SNAPSHOT_RETENTION_DAYS=730

# Integrations (Phase 7)
MOMENTUM_SLACK_ENABLED=false

# Asana importer (the token is entered per import and never stored)
MOMENTUM_ASANA_BASE_URL=https://app.asana.com/api/1.0

# Security headers (S7.5.2): who may frame Momentum, and a full CSP override for embedding hosts
MOMENTUM_SECURITY_HEADERS=true
MOMENTUM_FRAME_ANCESTORS='self'
MOMENTUM_CONTENT_SECURITY_POLICY=

# Agent platform (Phase 7.6, ADR-0012): packs, durable jobs, asks, plans
MOMENTUM_PACKS_ENABLED=true
MOMENTUM_PACKS=*
# load tests/packs/ (echo, asker, failer, spawner, consultee, planner_fixture); never true in prod
MOMENTUM_TEST_PACKS=false
MOMENTUM_AGENT_STEP_TIMEOUT_S=300
MOMENTUM_AGENT_JOB_MAX_ACTIVE_S=3600
MOMENTUM_AGENT_JOB_MAX_AGE_DAYS=30
MOMENTUM_AGENT_CHILD_CONCURRENCY=4
MOMENTUM_AGENT_MAX_CHILDREN=500
MOMENTUM_AGENT_STEP_OUTPUT_MAX_KB=256
MOMENTUM_ASK_REMIND_HOURS=24
MOMENTUM_ASK_EXPIRE_DAYS=7
MOMENTUM_PLAN_MAX_STEPS=12
MOMENTUM_AGENT_CONSULT_TIMEOUT_S=60
MOMENTUM_RECORD_MAX_ITEMS=5000
