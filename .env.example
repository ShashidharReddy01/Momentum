# Momentum: local development defaults. Every setting is documented in docs/architecture/configuration.md
MOMENTUM_ENV=local
MOMENTUM_SECRET_KEY=dev-only-change-me
MOMENTUM_BASE_PATH=
MOMENTUM_PUBLIC_BASE_URL=http://localhost:5173
MOMENTUM_LOG_LEVEL=INFO
MOMENTUM_LOG_FORMAT=console

# Database (docker compose postgres + pgvector)
MOMENTUM_DATABASE_URL=postgresql+psycopg://momentum:momentum@localhost:5432/momentum
MOMENTUM_DB_SCHEMA=momentum
MOMENTUM_DB_AUTO_MIGRATE=true

# Auth: dev | easyauth-sim | easyauth | oidc | host
MOMENTUM_AUTH_MODE=dev
MOMENTUM_BOOTSTRAP_ADMIN_EMAILS=admin@acme-demo.test
MOMENTUM_ALLOWED_EMAIL_DOMAINS=acme-demo.test
MOMENTUM_IDENTITY_LINK_BY_EMAIL=true

# Worker
MOMENTUM_WORKER_MODE=embedded

# Storage
MOMENTUM_STORAGE_BACKEND=local
MOMENTUM_STORAGE_LOCAL_DIR=./.data/files

# AI: mock by default; set gateway + URL/key to use LiteLLM
MOMENTUM_AI_ENABLED=true
MOMENTUM_LLM_MODE=mock
MOMENTUM_LLM_BASE_URL=http://localhost:4000/v1
MOMENTUM_LLM_API_KEY=
MOMENTUM_LLM_MODEL_FAST=claude-fast
MOMENTUM_LLM_MODEL_DEFAULT=claude-default
MOMENTUM_LLM_MODEL_SMART=claude-smart
MOMENTUM_LLM_EMBED_MODEL=cohere-embed-v3
MOMENTUM_LLM_EMBED_DIM=1024

# Integrations (Phase 7)
MOMENTUM_SLACK_ENABLED=false
